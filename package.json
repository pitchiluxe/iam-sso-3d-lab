{
  "name": "iam-sso-3d-lab",
  "type": "module",
  "version": "0.3.2",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:icons": "node build-icons.cjs",
    "build:desktop": "npm run build && npm run build:icons && electron-builder",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.mydigitalsolutions.iamsso3dlab",
    "productName": "IAM SSO 3D Lab",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IAM SSO 3D Lab"
    },
    "publish": {
      "provider": "github",
      "owner": "pitchiluxe",
      "repo": "iam-sso-3d-lab"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "nanoid": "^5.0.0",
    "three": "^0.169.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.3.0",
    "sharp": "^0.35.4",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
